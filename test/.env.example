# DB 시험(test/db)이 쓰는 값. 이 파일을 test/.env.local 로 복사해 내 PC 값을 넣는다 (.env.local 은 git 에 올리지 않는다)
# 비워 둔 DB 의 시험은 건너뛴다. 도커로 띄우는 방법은 docker/docker-compose.yml 참고.

# PostgreSQL: dev 프로필(application-dev.properties 또는 .yml)이 빈 시험용 DB 를 가리키는 BE 폴더.
# 시험이 처음 돌 때 그 DB 에 예시 스키마(test/fixtures/seed-postgres.sql)를 넣는다. 다른 테이블이 든 DB 면 넣지 않고 멈춘다.
# 예: src/main/resources/application-dev.properties 에
#     spring.datasource.url=jdbc:postgresql://127.0.0.1:25432/erdtest
#     spring.datasource.username=erd
#     spring.datasource.password={docker/.env 의 PG_PASSWORD}
ERD_BE_DIR=

# 나머지 DB: {이름}://{계정}:{비밀번호}@{호스트}:{포트}/{DB}. 비밀번호의 # 은 %23 처럼 URL 인코딩한다
# SQL Server 는 sa 계정, MySQL 과 Oracle 은 erd 계정 (관리 계정 root, system 도 같은 비밀번호로 둔다)
ERD_MSSQL_URL=      # 예: sqlserver://sa:{비밀번호}@127.0.0.1:1433/erdtest
ERD_MYSQL_URL=      # 예: mysql://erd:{비밀번호}@127.0.0.1:3306/erdtest
ERD_ORACLE_URL=     # 예: oracle://erd:{비밀번호}@127.0.0.1:1521/FREEPDB1
