# docker/docker-compose.yml 이 읽는 값. 이 파일을 docker/.env 로 복사해 비밀번호를 정한다 (.env 는 git 에 올리지 않는다)
# SQL Server 비밀번호는 8자 이상에 대문자, 소문자, 숫자, 기호 중 3가지가 들어가야 한다.
# Oracle 비밀번호는 글자로 시작하고 글자, 숫자만 쓰는 것이 안전하다.
PG_PASSWORD=
MSSQL_PASSWORD=
MYSQL_PASSWORD=
ORACLE_PASSWORD=

# 이미 쓰는 포트와 겹치면 바꾼다 (바꾸면 test/.env.local 의 URL 포트도 바꾼다)
PG_PORT=25432
MSSQL_PORT=1433
MYSQL_PORT=3306
ORACLE_PORT=1521
